#include <windows.h>
1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/icons/CyCodeReader.ico"
2 ICON "@CMAKE_CURRENT_SOURCE_DIR@/icons/CyCodeReader-document.ico"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "CompanyName", "Cyberalien\0"
   VALUE "FileDescription", "CyCodeReader\0"
   VALUE "FileVersion", "@PROJECT_VERSION@\0"
   VALUE "ProductName", "CyCodeReader\0"
   VALUE "ProductVersion", "@PROJECT_VERSION@\0"
   VALUE "LegalCopyright", "Copyright (c) 2026 Cyberalien\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
