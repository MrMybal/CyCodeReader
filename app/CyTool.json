    {
      "id": "search_open_documents",
      "name": "Search Open Documents",
      "description": "Bounded literal search over current live buffers. Results use zero-based UTF-8 byte offsets and one-based lines/byte columns. Case-insensitive matching folds ASCII only.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "caseSensitive": {
            "type": "boolean"
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "matches": {
            "type": "array",
            "maxItems": 2000,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1
                },
                "offset": {
                  "type": "integer",
                  "minimum": 0
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "column": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "id",
                "revision",
                "offset",
                "line",
                "column"
              ],
              "additionalProperties": false
            }
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "matches",
          "truncated"
        ],
        "additionalProperties": false
      },
      "resourceRequirements": {
        "ramBytes": 16777216
      },
      "supportedBackends": [],
      "permissions": [],
      "canRunAsync": true,
      "canCancel": true,
      "supportsProgress": false
    },
    {
      "id": "text_transform",
      "name": "Text Transform",
      "description": "Apply a native full-document text transformation at expectedRevision. Case conversion preserves non-ASCII bytes; no automatic save.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 1
          },
          "operation": {
            "type": "string",
            "enum": [
              "uppercase",
              "lowercase",
              "trimTrailing",
              "sortLines",
              "sortLinesDescending",
              "uniqueLines"
